<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-4 mt-4 inline-block" href="/logout">Logout</a>
        <h2 class="text-3xl">Hello, <%= user.name %> 👋</h2>
        <h1 class="mb-5">You can create new post.</h1>
        <form method="post" action="/post">
            <textarea class="p- 2 w-1/3 resize-none bg-gray-600 border-2 border-zinc-800 rounded-xl" name="content" id=""></textarea>
            <input class="px-5 py-2 rounded-2xl bg-blue-500 mt-2" type="submit" value="Create Post">
        </form>
        <div class="posts mt-20">
            <h3 class="text-3xl text-zinc-400">Your Post.</h3>
            <div class="postcontainer ">
                <% user.posts.reverse().forEach(function(post){ %>
                    <div class="post w-1/3 p-4 border-2 border-zinc-800 rounded-md mt-5">
                        <h4 class="text-blue-500">@<%= user.username %></h4>
                        <p class="text-md"><%= post.content %></p>
                        <small class="mt-2 inline-block"><%= post.likes.length %> Likes</small>
                        <div class="btns flex gap-2 mt-2">
                            <a class="bg-blue-500 px-3 py-1 rounded-md mr-2" href="/like/<%= post._id %>">
                                <%= post.likes.indexOf(user._id) === -1 ? 'Like' : 'Unlike' %>
                            </a>
                            <a class="bg-green-500 px-3 py-1 rounded-md mr-2" href="/edit/<%= post._id %>">Edit</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html> 