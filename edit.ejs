<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h1 class="mb-5">You can Edit post.</h1>
        <form method="post" action="/update/<%= post._id %>">
            <textarea class="p- 2 w-1/3 resize-none bg-gray-600 border-2 border-zinc-800 rounded-md" name="content" id=""><%= post.content %></textarea>
            <input class="px-5 py-2 rounded-xl bg-blue-500 mt-2" type="submit" value="Update Post">
        </form>
    </div>
</body>
</html> 