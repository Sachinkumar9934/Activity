<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white">
        <h2 class="text-3xl mb-5">Create Account</h2>
        <form action="register" method="post">
            <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-xl  border-zinc-300" type="text" name="name" class="" placeholder="Name...">
            <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-xl  border-zinc-300" type="text" name="username" class="" placeholder="Username...">
            <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-xl  border-zinc-300" type="text" name="number" class="" placeholder="Age...">
            <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-xl  border-zinc-300" type="text" name="email" class="" placeholder="Email...">
            <input class="px-3 py-2 outline-none bg-transparent border-2 rounded-xl  border-zinc-300" type="text" name="password" class="" placeholder="Password...">
            <input class="px-5 py-2 rounded-xl bg-blue-500" type="submit" value="Create Account">
            <a href="/login" class="px-5 py-2 rounded-xl bg-green-500">Login</a>
        </form>
    </div>
</body>
</html> 